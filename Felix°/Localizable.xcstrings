    "Begrenzt Hoch/Tief auf einen Zeitraum, z. B. für relevantere Tiefstwerte nach Sonnenaufgang." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt Hoch/Tief auf einen Zeitraum, z. B. für relevantere Tiefstwerte nach Sonnenaufgang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limits high/low to a time period, for example to make lows after sunrise more relevant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la máxima y la mínima a un periodo, por ejemplo para que las mínimas después del amanecer sean más relevantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la maximale et la minimale à une période, par exemple pour rendre les minimales après le lever du soleil plus pertinentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita massima e minima a un intervallo, ad esempio per rendere più significative le minime dopo l’alba."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高・最低を一定の時間帯に限定します。たとえば日の出後の最低気温をより意味のある値にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최고/최저를 특정 시간대로 제한합니다. 예를 들어 일출 이후의 최저 기온을 더 의미 있게 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt maximum/minimum tot een periode, bijvoorbeeld om minima na zonsopkomst relevanter te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita a máxima e a mínima a um período, por exemplo para tornar as mínimas após o nascer do sol mais relevantes."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將最高溫與最低溫限制在某個時段，例如讓日出後的最低溫更有參考價值。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将最高温与最低温限制在某个时段，例如让日出后的最低温更有参考价值。"
          }
        }
      }
    },
    "Bei diesem UV-Wert besteht nur eine geringe gesundheitliche Gefährdung. Meist sind keine besonderen Schutzmaßnahmen erforderlich." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei diesem UV-Wert besteht nur eine geringe gesundheitliche Gefährdung. Meist sind keine besonderen Schutzmaßnahmen erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At this UV level, the health risk is low. In most cases, no special protective measures are needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con este nivel de UV, el riesgo para la salud es bajo. En la mayoría de los casos no se necesitan medidas de protección especiales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À ce niveau d’UV, le risque pour la santé est faible. Dans la plupart des cas, aucune protection particulière n’est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con questo livello di UV, il rischio per la salute è basso. Nella maggior parte dei casi non servono protezioni speciali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このUVレベルでは健康へのリスクは低いです。多くの場合、特別な対策は必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 자외선 지수에서는 건강 위험이 낮습니다. 대부분 특별한 보호 조치가 필요하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij dit UV-niveau is het gezondheidsrisico laag. Meestal zijn geen bijzondere beschermingsmaatregelen nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com este índice UV, o risco à saúde é baixo. Na maioria dos casos, não são necessárias medidas de proteção especiais."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此紫外線指數下，健康危害很低。通常不需要特別的防護措施。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此紫外线指数下，健康危害很低。通常不需要特别的防护措施。"
          }
        }
      }
    },

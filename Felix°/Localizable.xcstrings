    "Kälter als %@ aller %@ seit %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kälter als %@ aller %@ seit %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colder than %@ of all %@ since %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más frío que el %1$@ de todos los %2$@ desde %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus froid que %1$@ de tous les %2$@ depuis %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più freddo del %1$@ di tutti i %2$@ dal %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@以降のすべての%2$@のうち%1$@より寒い。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais frio que %@ de todos os %@ desde %@."
          }
        },
        "zh-Hant" : {

          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color scale from cooler than normal (blue) to warmer than normal (red)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escala de color de más frío de lo normal (azul) a más cálido de lo normal (rojo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échelle de couleurs du plus froid que la normale (bleu) au plus chaud que la normale (rouge)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scala di colori da più freddo del normale (blu) a più caldo del normale (rosso)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常より寒い（青）から通常より暖かい（赤）までのカラースケール。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평년보다 추운(파란색)부터 평년보다 따뜻한(빨간색)까지의 색상 스케일."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

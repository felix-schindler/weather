    "Open-Meteo" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo"
          }
        }
      },
      "shouldTranslate" : false
    },
    "Open-Meteo ist eine Open-Source-Wetter-API, die offene Wetterdaten von verschiedenen internationalen Wetterdiensten sammelt. Felix° nutzt als nicht-kommerzielle App den kostenlosen Zugang zu Open-Meteo, unterstützt das Projekt aber mit einer monatlichen Spende von fünf Euro." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo ist eine Open-Source-Wetter-API, die offene Wetterdaten von verschiedenen internationalen Wetterdiensten sammelt. Felix° nutzt als nicht-kommerzielle App den kostenlosen Zugang zu Open-Meteo, unterstützt das Projekt aber mit einer monatlichen Spende von fünf Euro."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo is an open source weather API that collects open weather data from various international weather services. Felix° uses the free access to Open-Meteo as a non-commercial app, but supports the project with a monthly donation of five euros."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo es una API meteorológica de código abierto que reúne datos meteorológicos abiertos de distintos servicios internacionales. Felix° utiliza el acceso gratuito a Open-Meteo como app no comercial, pero apoya el proyecto con una donación mensual de cinco euros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo est une API météo open source qui rassemble des données météo ouvertes de différents services internationaux. En tant qu’application non commerciale, Felix° utilise l’accès gratuit à Open-Meteo, mais soutient le projet par un don mensuel de cinq euros."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo è un’API meteo open source che raccoglie dati meteo aperti da vari servizi meteorologici internazionali. Felix°, in quanto app non commerciale, usa l’accesso gratuito a Open-Meteo ma sostiene il progetto con una donazione mensile di cinque euro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteoは、各国の気象機関のオープンな気象データを集約するオープンソースの天気APIです。Felix°は非営利アプリとしてOpen-Meteoの無料アクセスを利用しつつ、月額5ユーロの寄付でプロジェクトを支援しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo는 여러 국제 기상 기관의 개방형 기상 데이터를 모으는 오픈 소스 날씨 API입니다. Felix°는 비영리 앱으로 Open-Meteo의 무료 액세스를 사용하며, 매월 5유로를 후원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo is een open-source weer-API die open weergegevens van verschillende internationale weerdiensten verzamelt. Felix° gebruikt als niet-commerciële app de gratis toegang tot Open-Meteo, maar steunt het project met een maandelijkse donatie van vijf euro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Open-Meteo é uma API meteorológica de código aberto que reúne dados meteorológicos abertos de diversos serviços meteorológicos internacionais. Felix°, como app não comercial, usa o acesso gratuito ao Open-Meteo, mas apoia o projeto com uma doação mensal de cinco euros."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo 是一套開源天氣 API，彙整來自各國際氣象機構的開放天氣資料。Felix° 身為非商業應用程式，使用 Open-Meteo 的免費存取服務，並以每月五歐元的捐款支持該專案。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo 是一套开源天气 API，汇整来自各国际气象机构的开放天气数据。Felix° 身为非商业应用程序，使用 Open-Meteo 的免费访问服务，并以每月五欧元的捐款支持该项目。"
          }
        }
      }
    },

    "Wähle, ob die Tageswerte ersetzt oder im 24-Stunden-Bereich markiert werden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, ob die Tageswerte ersetzt oder im 24-Stunden-Bereich markiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether daytime values replace the daily values or are marked within the 24-hour range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si los valores diurnos sustituyen a los diarios o se marcan dentro del intervalo de 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez si les valeurs diurnes remplacent les valeurs journalières ou sont marquées dans la plage de 24 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se i valori diurni sostituiscono quelli giornalieri o vengono segnati nell’intervallo di 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日中の値を日別の値と置き換えるか、24時間の範囲内にマークするかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일중 값을 일별 값과 교체할지, 24시간 범위 안에 표시할지 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies of dagwaarden de dagelijkse waarden vervangen of binnen het bereik van 24 uur worden gemarkeerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se os valores diários substituem os demais ou são marcados no intervalo de 24 horas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇每日數值要直接取代，或在 24 小時範圍內標示。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择每日数值要直接替换，或在 24 小时范围内标示。"
          }
        }
      }
    },
    "Wählt für jeden Ort weltweit automatisch das beste Modell und kombiniert mehrere Wetterdienste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt für jeden Ort weltweit automatisch das beste Modell und kombiniert mehrere Wetterdienste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically picks the best model for any location worldwide and combines several weather services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige automáticamente el mejor modelo para cualquier lugar del mundo y combina varios servicios meteorológicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisit automatiquement le meilleur modèle pour n’importe quel lieu dans le monde et combine plusieurs services météo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglie automaticamente il miglior modello per qualsiasi località nel mondo e combina più servizi meteo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界中のどの場所でも最適なモデルを自動選択し、複数の気象サービスを組み合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전 세계 어느 위치든 가장 적합한 모델을 자동으로 선택하고 여러 기상 서비스를 결합합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiest automatisch het beste model voor elke locatie wereldwijd en combineert meerdere weerdiensten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe automaticamente o melhor modelo para qualquer local no mundo e combina vários serviços meteorológicos."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為全球每個地點自動選擇最佳模型，並結合多個氣象服務。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为全球每个地点自动选择最佳模型，并结合多个气象服务。"
          }
        }
      }
    },
    "Wärmer als %@ aller %@ seit %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wärmer als %@ aller %@ seit %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warmer than %@ of all %@ since %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más cálido que el %1$@ de todos los %2$@ desde %3$@."
          }
        },
        "fr" : {

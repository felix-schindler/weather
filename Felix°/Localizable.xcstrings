    "Standardmäßig wählt Felix° automatisch das beste Wettermodell. Fortgeschrittene Nutzer können ein bestimmtes Modell erzwingen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig wählt Felix° automatisch das beste Wettermodell. Fortgeschrittene Nutzer können ein bestimmtes Modell erzwingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, Felix° automatically picks the best weather model. Advanced users can force a specific model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma predeterminada, Felix° elige automáticamente el mejor modelo meteorológico. Los usuarios avanzados pueden forzar un modelo concreto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, Felix° choisit automatiquement le meilleur modèle météo. Les utilisateurs avancés peuvent forcer un modèle précis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita, Felix° sceglie automaticamente il miglior modello meteo. Gli utenti esperti possono forzarne uno specifico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは、Felix°が最適な気象モデルを自動的に選択します。上級ユーザーは特定のモデルを強制できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, Felix° escolhe automaticamente o melhor modelo meteorológico. Usuários avançados podem forçar um modelo específico."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設情況下，Felix° 會自動選擇最佳天氣模型。進階使用者可強制指定特定模型。"
          }
        }
      }
    },
    "Standardmäßig wählt Felix° für jeden Ort automatisch das beste Modell und kombiniert mehrere Wetterdienste. Empfohlen für die meisten Nutzer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig wählt Felix° für jeden Ort automatisch das beste Modell und kombiniert mehrere Wetterdienste. Empfohlen für die meisten Nutzer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, Felix° automatically picks the best model for each location and combines several weather services. Recommended for most users."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma predeterminada, Felix° elige automáticamente el mejor modelo para cada lugar y combina varios servicios meteorológicos. Recomendado para la mayoría de los usuarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, Felix° choisit automatiquement le meilleur modèle pour chaque lieu et combine plusieurs services météo. Recommandé pour la plupart des utilisateurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita, Felix° sceglie automaticamente il miglior modello per ogni località e combina più servizi meteo. Consigliato per la maggior parte degli utenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは、Felix°が場所ごとに最適なモデルを自動選択し、複数の気象サービスを組み合わせます。ほとんどのユーザーに推奨されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, Felix° escolhe automaticamente o melhor modelo para cada localização e combina vários serviços meteorológicos. Recomendado para a maioria dos usuários."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設情況下，Felix° 會為每個地點自動選擇最佳模型，並結合多個氣象服務。推薦大多數使用者使用。"
          }
        }
      }
    },

    "Datengrundlage ist die ERA5-Reanalyse: Wettermodelle verrechnen Messungen von Stationen, Satelliten, Flugzeugen und Bojen zu einem lückenlosen, weltweiten Verlauf zurück bis 1940." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datengrundlage ist die ERA5-Reanalyse: Wettermodelle verrechnen Messungen von Stationen, Satelliten, Flugzeugen und Bojen zu einem lückenlosen, weltweiten Verlauf zurück bis 1940."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The data comes from the ERA5 reanalysis: weather models combine measurements from stations, satellites, aircraft, and buoys into a gap-free, worldwide record reaching back to 1940."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos proceden del reanálisis ERA5: los modelos meteorológicos combinan mediciones de estaciones, satélites, aviones y boyas en un registro mundial y sin lagunas que se remonta a 1940."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données proviennent de la réanalyse ERA5 : des modèles météo combinent des mesures de stations, de satellites, d’avions et de bouées en une série mondiale et continue remontant à 1940."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati provengono dalla rianalisi ERA5: i modelli meteo combinano misurazioni di stazioni, satelliti, aerei e boe in una serie mondiale e senza lacune che risale al 1940."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データはERA5再解析に基づいています。気象モデルが観測所、衛星、航空機、ブイの観測値を組み合わせ、1940年までさかのぼる継続的な世界記録を作成しています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A base de dados é a reanálise ERA5: os modelos meteorológicos combinam medições de estações, satélites, aeronaves e boias em um histórico global contínuo que remonta a 1940."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料基礎為 ERA5 再分析：天氣模型將測站、衛星、飛機與浮標的測量資料，彙整成可回溯至 1940 年、完整無缺的全球紀錄。"
          }
        }
      }
    },

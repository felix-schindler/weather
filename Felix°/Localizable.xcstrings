    "Hemd, Sonnencreme und Sonnenbrille schützen vor zu viel UV-Strahlung." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemd, Sonnencreme und Sonnenbrille schützen vor zu viel UV-Strahlung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shirt, sunscreen, and sunglasses protect against excessive UV exposure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una camisa, protector solar y gafas de sol protegen de una exposición excesiva a los rayos UV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une chemise, de la crème solaire et des lunettes de soleil protègent d’une exposition excessive aux UV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camicia, crema solare e occhiali da sole proteggono da un’esposizione eccessiva ai raggi UV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シャツ、日焼け止め、サングラスで紫外線の浴びすぎを防げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셔츠, 자외선 차단제, 선글라스가 과도한 자외선 노출을 막아줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een overhemd, zonnebrandcrème en een zonnebril beschermen tegen te veel uv-straling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camisa, protetor solar e óculos de sol protegem contra radiação UV excessiva."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "襯衫、防曬乳和太陽眼鏡可防止過度曝曬紫外線。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "衬衫、防晒霜和太阳镜可防止过度曝晒紫外线。"
          }
        }
      }
    },

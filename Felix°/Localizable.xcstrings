    "Jeder Streifen ist die Tageshöchsttemperatur an diesem Kalendertag eines Jahres, im Vergleich zum Normalwert (1961–1990). Tippe und ziehe über die Streifen, um einzelne Jahre abzulesen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Streifen ist die Tageshöchsttemperatur an diesem Kalendertag eines Jahres, im Vergleich zum Normalwert (1961–1990). Tippe und ziehe über die Streifen, um einzelne Jahre abzulesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each stripe is the daily high on this calendar day of a year, compared with the normal (1961–1990). Tap and drag across the stripes to read individual years."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada franja es la máxima diaria de este día del calendario en un año, comparada con el valor normal (1961–1990). Toca y desliza sobre las franjas para consultar años concretos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque bande représente la maximale quotidienne de ce jour du calendrier pour une année, comparée à la normale (1961–1990). Touchez et faites glisser le doigt sur les bandes pour lire les années."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni striscia è la massima giornaliera di questo giorno del calendario per un anno, confrontata con il valore normale (1961–1990). Tocca e trascina sulle strisce per leggere i singoli anni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ストライプは、その年のこの日の日最高気温を平年値（1961〜1990年）と比較したものです。ストライプをタップしてドラッグすると、各年を確認できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada faixa é a temperatura máxima do dia nesta data em um ano, comparada à normal (1961–1990). Toque e arraste pelas faixas para ler cada ano."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每道條紋代表某一年在這一天的每日最高溫，並與正常值（1961–1990）相比。點按並在條紋上拖曳，即可讀取各年份。"
          }
        }
      }
    },
    "Jetzt" : {

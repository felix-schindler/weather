    "Bodennahes Ozon bildet sich bei starker Sonneneinstrahlung aus Abgasen. Es kann Husten, Reizungen und eine verringerte Lungenfunktion auslösen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodennahes Ozon bildet sich bei starker Sonneneinstrahlung aus Abgasen. Es kann Husten, Reizungen und eine verringerte Lungenfunktion auslösen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ground-level ozone forms from emissions during strong sunlight. It can trigger coughing, irritation, and reduced lung function."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ozono troposférico se forma a partir de los gases de escape con una fuerte radiación solar. Puede provocar tos, irritación y una reducción de la función pulmonar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ozone au niveau du sol se forme à partir des gaz d’échappement sous un fort ensoleillement. Il peut provoquer toux, irritations et une baisse de la fonction pulmonaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ozono a livello del suolo si forma dai gas di scarico in presenza di forte irraggiamento solare. Può causare tosse, irritazioni e una ridotta funzionalità polmonare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地表付近のオゾンは、強い日差しのもとで排ガスから生成されます。咳や刺激、肺機能の低下を引き起こすことがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ozônio ao nível do solo se forma a partir de emissões sob forte radiação solar. Pode causar tosse, irritação e redução da função pulmonar."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近地面臭氧在強烈日照下由廢氣形成，可能引發咳嗽、刺激與肺功能下降。"
          }
        }
      }
    },

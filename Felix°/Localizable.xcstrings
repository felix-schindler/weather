          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglie automaticamente il miglior modello per qualsiasi località nel mondo e combina più servizi meteo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界中のどの場所でも最適なモデルを自動選択し、複数の気象サービスを組み合わせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe automaticamente o melhor modelo para qualquer local no mundo e combina vários serviços meteorológicos."

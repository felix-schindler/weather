    "PM" : {
      "comment" : "Environment PM",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM"
          }
        }
      }
    },
    "PM2.5 entsteht vor allem durch Verkehr, Holzfeuer und Industrie. Die feinen Partikel dringen tief in die Lunge ein und belasten Atemwege und Herz-Kreislauf-System." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM2.5 entsteht vor allem durch Verkehr, Holzfeuer und Industrie. Die feinen Partikel dringen tief in die Lunge ein und belasten Atemwege und Herz-Kreislauf-System."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM2.5 mainly comes from traffic, wood burning, and industry. These fine particles can penetrate deep into the lungs and strain the airways and cardiovascular system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las PM2.5 proceden principalmente del tráfico, la combustión de leña y la industria. Estas partículas finas penetran profundamente en los pulmones y afectan a las vías respiratorias y al sistema cardiovascular."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les PM2,5 proviennent principalement du trafic, du chauffage au bois et de l’industrie. Ces particules fines pénètrent profondément dans les poumons et sollicitent les voies respiratoires et le système cardiovasculaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PM2,5 provengono soprattutto da traffico, stufe a legna e industria. Queste particelle fini penetrano in profondità nei polmoni e affaticano le vie respiratorie e il sistema cardiovascolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM2.5は主に交通、薪の燃焼、産業から発生します。微細な粒子は肺の奥深くまで入り込み、気道や心血管系に負担をかけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PM2.5 vem principalmente do tráfego, da queima de madeira e da indústria. Essas partículas finas penetram fundo nos pulmões e sobrecarregam as vias respiratórias e o sistema cardiovascular."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM2.5 主要來自交通、燃燒木材與工業。這些細微粒子會深入肺部，對呼吸道與心血管系統造成負擔。"
          }
        }
      }
    },
    "PM10 stammt oft aus Straßenstaub, Baustellen und Landwirtschaft. Die Partikel reizen Augen und Atemwege und können Beschwerden bei empfindlichen Personen verstärken." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM10 stammt oft aus Straßenstaub, Baustellen und Landwirtschaft. Die Partikel reizen Augen und Atemwege und können Beschwerden bei empfindlichen Personen verstärken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM10 often comes from road dust, construction sites, and agriculture. These particles can irritate the eyes and airways and worsen symptoms in sensitive people."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las PM10 suelen proceder del polvo de las calles, las obras y la agricultura. Estas partículas irritan los ojos y las vías respiratorias y pueden agravar los síntomas en personas sensibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les PM10 proviennent souvent de la poussière des rues, des chantiers et de l’agriculture. Ces particules irritent les yeux et les voies respiratoires et peuvent aggraver les symptômes chez les personnes sensibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il PM10 proviene spesso da polvere stradale, cantieri e agricoltura. Queste particelle irritano occhi e vie respiratorie e possono peggiorare i sintomi nelle persone sensibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM10は主に道路の粉じん、工事現場、農業から発生します。粒子は目や気道を刺激し、敏感な人の症状を悪化させることがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PM10 costuma vir da poeira das ruas, de obras e da agricultura. Essas partículas irritam os olhos e as vias respiratórias e podem intensificar os sintomas em pessoas sensíveis."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM10 通常來自道路揚塵、工地與農業。這些微粒會刺激眼睛與呼吸道，並可能加重敏感族群的症狀。"
          }
        }
      }
    },

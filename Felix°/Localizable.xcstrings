          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically picks the best model for any location worldwide and combines several weather services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige automáticamente el mejor modelo para cualquier lugar del mundo y combina varios servicios meteorológicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

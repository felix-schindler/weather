    "„Mein Standort“ bleibt als Untertitel sichtbar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Mein Standort“ bleibt als Untertitel sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“My Location” stays visible as a subtitle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mi ubicación” permanece visible como subtítulo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Mon lieu » reste visible comme sous-titre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“La mia posizione” resta visibile come sottotitolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「現在地」はサブタイトルとして表示されたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「현재 위치」는 부제목으로 계속 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Mijn locatie’ blijft zichtbaar als ondertitel."
          }

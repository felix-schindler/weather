    "Überblick" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überblick"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overview"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

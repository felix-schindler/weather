    "Dann zeigt Felix° das Wetter genau hier und sagt Bescheid, bevor es regnet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann zeigt Felix° das Wetter genau hier und sagt Bescheid, bevor es regnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then Felix° shows the weather right here and lets you know before it rains."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entonces Felix° te muestra el tiempo justo aquí y te avisa antes de que llueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felix° affiche alors la météo ici même et vous prévient avant qu’il ne pleuve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allora Felix° mostra il meteo proprio qui e ti avvisa prima che piova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そうすると Felix° がここでの天気を表示し、雨が降る前に知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그러면 Felix°가 바로 이곳의 날씨를 보여주고 비가 오기 전에 알려줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan toont Felix° het weer precies hier en laat het je weten voordat het gaat regenen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Então Felix° mostra o tempo bem aqui e avisa antes de chover."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接著，Felix° 會在這裡顯示天氣狀況，並在下雨前通知你。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接着，Felix° 会在这里显示天气状况，并在下雨前通知你。"
          }
        }
      }
    },

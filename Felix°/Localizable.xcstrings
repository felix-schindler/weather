    "So einig ist sich die Vorhersage. Bei schmalem Band sagen fast alle Berechnungen dasselbe, bei breitem kann der Tag noch so oder so ausgehen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much the forecast models agree. With a narrow band, almost every calculation says the same; with a wide one, the day can still go either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grado de acuerdo de la previsión. Si la banda es estrecha, casi todos los cálculos coinciden; si es ancha, el día aún puede ir de una u otra forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quel point les prévisions concordent. Avec une bande étroite, presque tous les calculs disent la même chose ; avec une bande large, la journée peut encore basculer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto sono concordi le previsioni. Con una banda stretta quasi tutti i calcoli dicono lo stesso; con una larga, la giornata può ancora andare in un modo o nell’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予報モデルの一致度を示します。帯が狭い場合はほぼすべての計算が同じ結果を示し、広い場合は当日の天気がどちらにも転び得ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예보 모델이 얼마나 일치하는지를 보여줍니다. 띠가 좁으면 거의 모든 계산이 같은 결과를, 넓으면 당일 날씨가 어느 쪽으로도 갈 수 있음을 뜻합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe eensgezind de weermodellen zijn. Bij een smalle band zeggen bijna alle berekeningen hetzelfde; bij een brede kan de dag nog beide kanten op."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O quanto os modelos de previsão concordam. Com uma faixa estreita, quase todos os cálculos dizem o mesmo; com uma faixa larga, o dia ainda pode seguir caminhos diferentes."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預報模型的一致性。帶狀範圍窄時，幾乎所有運算結果都相同；範圍寬時，當天天氣仍可能有不同結果。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预报模型的一致性。带状范围窄时，几乎所有运算结果都相同；范围宽时，当天天气仍可能有不同结果。"
          }
        }
      }
    },
    "So kühl war ein %@ zuletzt %@ (%@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So kühl war ein %@ zuletzt %@ (%@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ was last this cool in %@ (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un %1$@ no estaba tan frío desde %2$@ (%3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’avait pas fait aussi frais un %1$@ depuis %2$@ (%3$@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un %1$@ non era così freddo dal %2$@ (%3$@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がこれほど寒かったのは%2$@（%3$@）以来です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이 이렇게 추웠던 것은 %2$@(%3$@) 이후 처음입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een %1$@ was voor het laatst zo koel in %2$@ (%3$@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A última vez que um %@ esteve tão frio foi em %@ (%@)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一次這麼涼的 %@ 是在 %@（%@）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一次这么凉的 %@ 是在 %@（%@）。"
          }
        }
      }
    },
    "So kühl wie heute war es seit %@ noch nie." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So kühl wie heute war es seit %@ noch nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It hasn't been this cool since %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No había hecho tanto frío como hoy desde %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’avait pas fait aussi frais depuis %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non faceva così freddo dal %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日ほど寒かった日は%1$@以来ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 이후 오늘처럼 추운 적이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is sinds %1$@ niet zo koel geweest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não estava tão frio assim desde %@."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %@ 以來從未這麼涼過。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %@ 以来从未这么凉过。"
          }
        }
      }
    },

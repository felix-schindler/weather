    "Feines Raster über Zentraleuropa, das auch einzelne Schauer und Gewitter abbilden kann. Stündlich bis 36 Stunden voraus, alle 3 Stunden ein neuer Lauf." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feines Raster über Zentraleuropa, das auch einzelne Schauer und Gewitter abbilden kann. Stündlich bis 36 Stunden voraus, alle 3 Stunden ein neuer Lauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fine grid over Central Europe that can depict individual showers and thunderstorms. Hourly up to 36 hours ahead, with a new run every 3 hours."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grade fina sobre a Europa Central, capaz de representar também pancadas de chuva e tempestades isoladas. De hora em hora até 36 horas à frente, com uma nova rodada a cada 3 horas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "涵蓋中歐的細緻網格，也能呈現個別的陣雨與雷雨。每小時更新，預報至 36 小時後，每 3 小時進行一次新的運算。"
          }
        }
      }
    },

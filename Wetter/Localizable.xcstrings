    },
    "Zwei Radare auf Gran Canaria und Teneriffa. Berge wie der Teide können einzelne Bereiche verdecken." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Radare auf Gran Canaria und Teneriffa. Berge wie der Teide können einzelne Bereiche verdecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two radars on Gran Canaria and Tenerife. Mountains such as Teide can block parts of the view."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大加那利島與特內里費島各有一座雷達，共兩座。像泰德峰這樣的山脈可能遮蔽部分區域。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois radares em Gran Canaria e Tenerife. Montanhas como o Teide podem bloquear algumas áreas."
          }
        }
      }
    },
    "Zweige bewegen sich, loses Papier hebt ab." : {

    "Ein Wettermodell berechnet aus Millionen Messungen, wie sich die Atmosphäre entwickelt. Die Karte zeigt, was das Modell erwartet, nicht was gemessen wurde." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wettermodell berechnet aus Millionen Messungen, wie sich die Atmosphäre entwickelt. Die Karte zeigt, was das Modell erwartet, nicht was gemessen wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A weather model uses millions of measurements to compute how the atmosphere will develop. The map shows what the model expects, not what was measured."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天氣模型會根據數百萬筆觀測資料，計算大氣的發展。地圖顯示的是模型的預測，而不是實際觀測的結果。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um modelo meteorológico calcula, a partir de milhões de medições, como a atmosfera vai evoluir. O mapa mostra o que o modelo espera, não o que foi medido."
          }
        }
      }
    },

    "Weltweites Modell. Stündlich bis 36 Stunden, danach in 4-Stunden-Schritten bis 3,5 Tage voraus. Alle 6 Stunden ein neuer Lauf." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weltweites Modell. Stündlich bis 36 Stunden, danach in 4-Stunden-Schritten bis 3,5 Tage voraus. Alle 6 Stunden ein neuer Lauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Global model. Hourly up to 36 hours, then in 4-hour steps up to 3.5 days ahead. A new run every 6 hours."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo global. De hora em hora até 36 horas, depois em intervalos de 4 horas até 3,5 dias à frente. Uma nova rodada a cada 6 horas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全球模型。前 36 小時為每小時，之後以 4 小時為間隔，最遠涵蓋未來 3.5 天。每 6 小時進行一次新的運算。"
          }
        }
      }
    },

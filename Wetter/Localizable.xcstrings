    },
    "Standard wiederherstellen" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard wiederherstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore default"
          }
        },
        "pt-BR" : {
          "stringUnit" : {

    "Rund 29 Radarstandorte, die nicht gleichzeitig melden. Deshalb kann das Bild Lücken haben." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rund 29 Radarstandorte, die nicht gleichzeitig melden. Deshalb kann das Bild Lücken haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About 29 radar sites that don't report at the same time, so the image can have gaps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de 29 estações de radar que não reportam ao mesmo tempo. Por isso, a imagem pode ter lacunas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約 29 個雷達測站並非同時回報，因此影像可能出現空缺。"
          }
        }
      }
    },

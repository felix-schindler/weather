            "value" : "Restaurar padrão"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復預設值"
          }
        }
      }
    },
    "Standardmäßig wählt Wetter automatisch das beste Wettermodell. Fortgeschrittene Nutzer können ein bestimmtes Modell erzwingen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig wählt Wetter automatisch das beste Wettermodell. Fortgeschrittene Nutzer können ein bestimmtes Modell erzwingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, Weather automatically picks the best weather model. Advanced users can force a specific model."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, o Tempo escolhe automaticamente o melhor modelo meteorológico. Usuários avançados podem forçar um modelo específico."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設情況下，天氣會自動選擇最佳天氣模型。進階使用者可強制指定特定模型。"
          }
        }
      }
    },
    "Standardmäßig wählt Wetter für jeden Ort automatisch das beste Modell und kombiniert mehrere Wetterdienste. Empfohlen für die meisten Nutzer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig wählt Wetter für jeden Ort automatisch das beste Modell und kombiniert mehrere Wetterdienste. Empfohlen für die meisten Nutzer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, Weather automatically picks the best model for each location and combines several weather services. Recommended for most users."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, o Tempo escolhe automaticamente o melhor modelo para cada localização e combina vários serviços meteorológicos. Recomendado para a maioria dos usuários."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設情況下，天氣會為每個地點自動選擇最佳模型，並結合多個氣象服務。推薦大多數使用者使用。"
          }
        }
      }
    },

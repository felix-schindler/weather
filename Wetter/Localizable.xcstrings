    "Gemeinsames Radarbild der europäischen Wetterdienste. Gemessen wird alle 15 Minuten, die Bilder dazwischen berechnet Wetter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsames Radarbild der europäischen Wetterdienste. Gemessen wird alle 15 Minuten, die Bilder dazwischen berechnet Wetter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joint radar image of Europe's national weather services. It is measured every 15 minutes; Weather computes the images in between."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagem de radar conjunta dos serviços meteorológicos europeus. A medição ocorre a cada 15 minutos; o Tempo calcula as imagens intermediárias."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歐洲各國氣象局的聯合雷達圖。每 15 分鐘實測一次，中間的影像由天氣推算。"
          }
        }
      }
    },

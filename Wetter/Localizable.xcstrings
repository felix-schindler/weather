    "Blätter rascheln, Wind ist im Gesicht spürbar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blätter rascheln, Wind ist im Gesicht spürbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves rustle and the wind is felt on the face."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "樹葉沙沙作響，臉上能感受到風。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

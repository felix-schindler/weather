    "Meteosat der dritten Generation über 0° Länge, Produkt Optimal Cloud Analysis. Zum Rand der Erdscheibe hin wird das Bild gröber. Contains modified EUMETSAT Meteosat data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meteosat der dritten Generation über 0° Länge, Produkt Optimal Cloud Analysis. Zum Rand der Erdscheibe hin wird das Bild gröber. Contains modified EUMETSAT Meteosat data."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meteosat Third Generation at 0° longitude, Optimal Cloud Analysis product. The image gets coarser toward the edge of the Earth's disk. Contains modified EUMETSAT Meteosat data."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第三代 Meteosat 衛星位於 0° 經度，產品為 Optimal Cloud Analysis。越靠近地球圓盤邊緣，影像越粗糙。Contains modified EUMETSAT Meteosat data."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meteosat de terceira geração sobre 0° de longitude, produto Optimal Cloud Analysis. A imagem fica mais grosseira em direção à borda do disco terrestre. Contains modified EUMETSAT Meteosat data."
          }
        }
      }
    },

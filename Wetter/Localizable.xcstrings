            "state" : "translated",
            "value" : "Severe storm damage, rare inland."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danos graves de tempestade, raros no interior."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嚴重的風暴損害，內陸少見。"
          }
        }
      }
    },

    "Open-Meteo" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo"
          }
        }
      },
      "shouldTranslate" : false
    },
    "Open-Meteo ist eine Open-Source-Wetter-API, die offene Wetterdaten von verschiedenen internationalen Wetterdiensten sammelt. Wetter nutzt als nicht-kommerzielle App den kostenlosen Zugang zu Open-Meteo, unterstützt das Projekt aber mit einer monatlichen Spende von fünf Euro." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo ist eine Open-Source-Wetter-API, die offene Wetterdaten von verschiedenen internationalen Wetterdiensten sammelt. Wetter nutzt als nicht-kommerzielle App den kostenlosen Zugang zu Open-Meteo, unterstützt das Projekt aber mit einer monatlichen Spende von fünf Euro."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo is an open source weather API that collects open weather data from various international weather services. Weather uses the free access to Open-Meteo as a non-commercial app, but supports the project with a monthly donation of five euros."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Open-Meteo é uma API meteorológica de código aberto que reúne dados meteorológicos abertos de diversos serviços meteorológicos internacionais. O Tempo, como app não comercial, usa o acesso gratuito ao Open-Meteo, mas apoia o projeto com uma doação mensal de cinco euros."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Meteo 是一套開源天氣 API，彙整來自各國際氣象機構的開放天氣資料。天氣身為非商業應用程式，使用 Open-Meteo 的免費存取服務，並以每月五歐元的捐款支持該專案。"
          }
        }
      }
    },

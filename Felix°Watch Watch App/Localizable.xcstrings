          "stringUnit" : {
            "state" : "translated",
            "value" : "Branches break and minor damage is possible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galhos se quebram e danos menores são possíveis."

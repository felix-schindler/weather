          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically picks the best model for any location worldwide and combines several weather services."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe automaticamente o melhor modelo para qualquer local no mundo e combina vários serviços meteorológicos."
          }

    "Bäume können entwurzelt werden, Gebäude können Schaden nehmen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bäume können entwurzelt werden, Gebäude können Schaden nehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trees can be uprooted and buildings can be damaged."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árvores podem ser arrancadas e edifícios podem sofrer danos."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "樹木可能被連根拔起，建築物可能受損。"
          }
        }
      }
    },
    "Bäume schwanken, Gehen gegen den Wind wird mühsam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bäume schwanken, Gehen gegen den Wind wird mühsam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trees sway and walking into the wind becomes difficult."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As árvores balançam e caminhar contra o vento fica penoso."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "樹木搖晃，逆風行走變得吃力。"
